{
  "name": "hippocampusllms-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "evaluate": "node tests/evaluation.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "format": "prettier --write .",
    "smoke:published": "node scripts/published-smoke.mjs",
    "smoke:hosts": "node scripts/host-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
